#include <windows.h>

1 RT_MANIFEST "app.manifest"

/* 3proxy.exe is embedded and dropped to %ProgramData%\modlink\bin on first run.
 * tools/fetch-3proxy.ps1 places the file here before the build. */
101 RCDATA "3proxy.exe"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "modlink - LTE modem proxy panel"
      VALUE "FileVersion",     "2.0.0.0"
      VALUE "ProductName",     "modlink"
      VALUE "ProductVersion",  "2.0.0.0"
      VALUE "Comments",        "Bundles 3proxy (c) Vladimir Dubrovin, BSD-style license - see THIRD-PARTY.txt"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
